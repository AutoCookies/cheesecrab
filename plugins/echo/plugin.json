{
  "name": "echo",
  "description": "Example installed plugin that echoes the JSON arguments it receives.",
  "command": "python3 run.py",
  "dangerous": false,
  "timeout_sec": 30,
  "args_schema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "Message to echo."
      }
    },
    "required": ["message"]
  }
}
